---
import Base from '../layouts/Base.astro';
import WorkTile from '../components/WorkTile.astro';
import { getWork } from '../lib/work';
import { site } from '../site';

const work = await getWork();
---
<Base>
  <section class="hero shell">
    <h1 class="reveal"><span>{site.name}.</span> <span class="dim">{site.intro}</span></h1>
    <dl class="facts reveal">
      <div><dt>Contact</dt><dd><a href={`mailto:${site.email}`}>Email</a></dd></div>
      <div><dt>Elsewhere</dt><dd>{site.links.map((l, i) => <>{i > 0 && ', '}<a href={l.href}>{l.label}</a></>)}</dd></div>
    </dl>
  </section>

  <section id="work" class="section shell">
    <header class="section-head">
      <h2>Selected work</h2>
    </header>
    <div class="grid">
      {work.map((entry, i) => <WorkTile entry={entry} index={i} />)}
    </div>
  </section>

  <section id="about" class="section shell split">
    <h2>About</h2>
    <div class="body">{site.about.map((p) => <p>{p}</p>)}</div>
  </section>
</Base>
