import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <article class="page shell">
    <h1 class="reveal">Page not found</h1>
    <p class="lede reveal">Nothing lives at this address. It may have moved, or the link may be wrong.</p>
    <dl class="facts reveal">
      <div><dt>Try</dt><dd><a href="/">Home</a>, <a href="/notes/">Notes</a></dd></div>
    </dl>
  </article>
</Base>
