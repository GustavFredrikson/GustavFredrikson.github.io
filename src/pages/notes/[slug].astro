---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getNotes, formatDate } from '../../lib/notes';
import { site } from '../../site';

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const post = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.summary,
  datePublished: d.date.toISOString().slice(0, 10),
  url: new URL(`/notes/${entry.id}/`, Astro.site),
  author: { '@type': 'Person', name: site.name, url: Astro.site },
  keywords: d.tags,
};
---
<Base title={d.title} description={d.summary} type="article" published={d.date}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(post)} />
  <article class="page note shell">
    <a class="back" href="/notes/">← All notes</a>
    <h1 class="reveal">{d.title}</h1>
    <p class="lede reveal">{d.summary}</p>

    <dl class="facts reveal">
      <div><dt>Date</dt><dd><time datetime={d.date.toISOString().slice(0, 10)}>{formatDate(d.date)}</time></dd></div>
      {d.tags.length > 0 && <div><dt>Tags</dt><dd>{d.tags.join(', ')}</dd></div>}
    </dl>

    <div class="prose"><Content /></div>
  </article>
</Base>
