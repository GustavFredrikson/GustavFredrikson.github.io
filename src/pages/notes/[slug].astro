---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NoteOutline from '../../components/NoteOutline.astro';
import { getNotes, formatDate } from '../../lib/notes';
import { site } from '../../site';

export async function getStaticPaths() {
  const notes = await getNotes();
  // Notes are newest first, so "next" is the one before it in time, wrapping at the end.
  return notes.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: notes[(i + 1) % notes.length] },
  }));
}

const { entry, next } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;

const post = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.summary,
  datePublished: d.date.toISOString().slice(0, 10),
  url: new URL(`/notes/${entry.id}/`, Astro.site),
  author: { '@type': 'Person', name: site.name, url: Astro.site },
  keywords: d.tags,
};
---
<Base title={d.title} description={d.summary} type="article" published={d.date}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(post)} />
  <article class="page note shell">
    <a class="back" href="/notes/">← All notes</a>
    <h1 class="reveal">{d.title}</h1>
    <p class="lede reveal">{d.summary}</p>

    <dl class="facts reveal">
      <div><dt>Date</dt><dd><time datetime={d.date.toISOString().slice(0, 10)}>{formatDate(d.date)}</time></dd></div>
      {d.tags.length > 0 && <div><dt>Tags</dt><dd>{d.tags.join(', ')}</dd></div>}
    </dl>

    <div class="note-body">
      <NoteOutline headings={headings} />
      <div class="prose"><Content /></div>
    </div>

    {next && next.id !== entry.id && (
      <a class="next" href={`/notes/${next.id}/`}>
        <span>Next note</span>
        <strong>{next.data.title} →</strong>
      </a>
    )}
  </article>
</Base>
