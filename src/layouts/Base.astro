---
import '@fontsource-variable/schibsted-grotesk';
// Same file the @font-face above resolves to, so Vite gives both one hashed URL.
import latinFont from '@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url';
import '../styles/global.css';
import { site } from '../site';

interface Props {
  title?: string;
  description?: string;
  // Social sharing image: a path or absolute URL. Defaults to public/og.png (tools/covers/og.html).
  image?: string;
  type?: 'website' | 'article';
  published?: Date;
}
const { title, description = site.intro, image = '/og.png', type = 'website', published } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : site.name;
const defaultImage = image === '/og.png';
const onHome = Astro.url.pathname === '/';
const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    {defaultImage && <meta property="og:image:width" content="1200" />}
    {defaultImage && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={defaultImage ? `${site.name}. ${site.intro}` : pageTitle} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — Notes`} href="/rss.xml" />
    <link rel="preload" href={latinFont} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <script is:inline>
      // Resolve the theme before first paint: a saved choice wins, else follow the system.
      (() => {
        const root = document.documentElement;
        const system = matchMedia('(prefers-color-scheme: dark)');
        const saved = () => { try { return localStorage.getItem('theme'); } catch { return null; } };
        const apply = (theme) => {
          root.dataset.theme = theme;
          // Point dark cover variants at the chosen theme rather than the system's.
          document.querySelectorAll('source[data-dark]').forEach((el) => { el.media = theme === 'dark' ? 'all' : 'not all'; });
          document.querySelectorAll('.theme-toggle').forEach((el) => el.setAttribute('aria-checked', theme === 'dark'));
        };
        apply(saved() || (system.matches ? 'dark' : 'light'));
        system.addEventListener('change', (e) => { if (!saved()) apply(e.matches ? 'dark' : 'light'); });
        document.addEventListener('DOMContentLoaded', () => apply(root.dataset.theme));
        window.toggleTheme = () => {
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          try { localStorage.setItem('theme', next); } catch {}
          apply(next);
        };
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="site-header shell">
      <a class="wordmark" href="/">{site.name}</a>
      <div class="header-end">
        <button class="theme-toggle" type="button" role="switch" aria-label="Dark mode" onclick="toggleTheme()">
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
          </svg>
          <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z" />
          </svg>
        </button>
        <nav aria-label="Main">
          <a href={onHome ? '#work' : '/#work'}>Work</a>
          <a href={onHome ? '#open-source' : '/#open-source'}>Open source</a>
          <a href="/notes/">Notes</a>
          <a href={onHome ? '#about' : '/#about'}>About</a>
        </nav>
      </div>
    </header>

    <main id="content"><slot /></main>

    <footer class="site-footer shell">
      <span>© {year} {site.name}</span>
      <a href="/privacy/">Privacy</a>
    </footer>
  </body>
</html>
