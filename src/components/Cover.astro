---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// A cover image with an optional dark-mode variant, swapped by the browser
// through prefers-color-scheme. The theme toggle in Base.astro rewrites the
// source's media query when the visitor picks a theme by hand.
// `name` is a view-transition-name, set on the <img> itself so it works with
// or without the <picture> wrapper; it must be unique on the page.
interface Props { src: ImageMetadata; dark?: ImageMetadata; widths: number[]; sizes: string; class?: string; priority?: boolean; name?: string }
const { src, dark, widths, sizes, class: className, priority, name } = Astro.props;
// Above-the-fold covers load right away instead of lazily.
const load = priority ? { loading: 'eager', fetchpriority: 'high' } as const : {};
const style = name ? `view-transition-name: ${name}` : undefined;
const darkImage = dark && (await getImage({ src: dark, widths, sizes }));
---
{darkImage ? (
  <picture>
    <source data-dark media="(prefers-color-scheme: dark)" srcset={darkImage.srcSet.attribute} sizes={sizes} />
    <Image class={className} src={src} alt="" widths={widths} sizes={sizes} style={style} {...load} />
  </picture>
) : (
  <Image class={className} src={src} alt="" widths={widths} sizes={sizes} style={style} {...load} />
)}
