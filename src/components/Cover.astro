---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// A cover image with an optional dark-mode variant, swapped by the browser
// through prefers-color-scheme. The theme toggle in Base.astro rewrites the
// source's media query when the visitor picks a theme by hand.
interface Props { src: ImageMetadata; dark?: ImageMetadata; widths: number[]; sizes: string; class?: string; priority?: boolean }
const { src, dark, widths, sizes, class: className, priority } = Astro.props;
// Above-the-fold covers load right away instead of lazily.
const load = priority ? { loading: 'eager', fetchpriority: 'high' } as const : {};
const darkImage = dark && (await getImage({ src: dark, widths, sizes }));
---
{darkImage ? (
  <picture>
    <source data-dark media="(prefers-color-scheme: dark)" srcset={darkImage.srcSet.attribute} sizes={sizes} />
    <Image class={className} src={src} alt="" widths={widths} sizes={sizes} {...load} />
  </picture>
) : (
  <Image class={className} src={src} alt="" widths={widths} sizes={sizes} {...load} />
)}
